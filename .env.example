# --- Required ---
# TMDB key for movie/TV/availability data.
# Get one free at https://www.themoviedb.org/settings/api
# Both formats are accepted:
#   - v3 API key (32-char hex) — copy from "API Key (v3 auth)"
#   - v4 read-access token (JWT, starts with "eyJ") — copy from "API Read Access Token"
TMDB_API_KEY=

# --- Optional, only needed for /smart (AI search) ---
# Free tier: 30 req/min on llama-3.3-70b-versatile.
# Get one free at https://console.groq.com (no credit card)
GROQ_API_KEY=
